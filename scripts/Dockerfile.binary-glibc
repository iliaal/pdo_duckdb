ARG PHP_IMAGE=php:8.4-cli-bookworm@sha256:138a210978c7767ef2a26f499c413fe6de1c13233c9a5068139565c81191b1ac
FROM gcc:13.5.0-bookworm@sha256:20eec427045c47d0aad1bd28c81d435916c327cd992240aa78350f755d04d04a AS compiler
FROM ${PHP_IMAGE}

# DuckDB's GA archives use the GCC 13 iostream initialization ABI. Keep both
# the compiler and static runtime built against the Debian 12 baseline.
COPY --from=compiler /usr/local/ /usr/local/
ENV CC=gcc CXX=g++
RUN apt-get update \
    && apt-get install -y --no-install-recommends autoconf make pkg-config python3 \
    && rm -rf /var/lib/apt/lists/* \
    && test "$(gcc -dumpversion)" = 13.5.0 \
    && test "$(g++ -dumpversion)" = 13.5.0
